{
  "default_provider": "openai-compatible",
  "providers": {
    "openai-compatible": {
      "base_url": "https://api.openai.com/v1",
      "model": "replace-with-your-model",
      "api_key": "${ARABICA_AI_API_KEY}",
      "timeout_seconds": 30,
      "max_request_bytes": 262144,
      "max_response_bytes": 1048576,
      "max_tokens": 2048
    }
  }
}
