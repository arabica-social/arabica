{
  "name": "arabica-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "svelte-kit sync && storybook dev -p 6006",
    "storybook:build": "svelte-kit sync && storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@storybook/svelte": "10.6.5",
    "@storybook/sveltekit": "10.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "storybook": "10.6.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
